# BharatShield environment configuration
# Copy this file to .env and fill in real values
# NEVER commit .env to git — it contains real secrets

# ── NewsAPI ──────────────────────────────────────────────────
# Get a free key at https://newsapi.org/register
NEWSAPI_KEY=dc8459582b0e442abcfd0de9c7f128a8

# ── Whisper model size ───────────────────────────────────────
# Options: tiny | base | small | medium | large-v3
# Recommendation: small for M1 Mac, medium/large-v3 for RTX 3070
WHISPER_MODEL=small

# ── Harmful speech threshold ─────────────────────────────────
# Probabilities above this are flagged as harmful
HARM_THRESHOLD=0.50

# ── Fact-check search settings ───────────────────────────────
NEWS_DAYS_BACK=30
DDG_MAX_RESULTS=5
NEWS_MAX_ARTICLES=5

# ── Deepfake confidence threshold ────────────────────────────
# P(FAKE) above this → label as Fake
FAKE_THRESHOLD=0.50

# ── HMAC secret for audit chain ──────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
BHARATSHIELD_HMAC_SECRET=9f4a29700a7890dcd966e510709cd5f04be23363b3a0aaa2272934e7637add93

# ── Flask ────────────────────────────────────────────────────
FLASK_PORT=5000
FLASK_DEBUG=false

# ── Model cache ──────────────────────────────────────────────
# Override HuggingFace and torch cache directories
# HF_HOME=.model_cache
# TORCH_HOME=.model_cache
